rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    function isAdmin() { return myEmail() == 'dimondfashion95@gmail.com'; }
    function riderDoc() { return /databases/$(database)/documents/riders/$(myEmail()); }
    function isRider() { return myEmail() != '' && exists(riderDoc()) && get(riderDoc()).data.active == true; }

    // Shop PC + staff phones (DF Staff, DF Tailoring, DF Reports) – har staff ka email yahan jodein
    function dfStaff() {
      return myEmail() in [
        'pos@diamondfashions.in',
        'dimondfashion95@gmail.com',
        'a95626201@gmail.com'
      ] || (myEmail() != '' && exists(/databases/$(database)/documents/staff/$(myEmail()))
            && get(/databases/$(database)/documents/staff/$(myEmail())).data.active == true);
    }

    function kActive(tok) { return get(/databases/$(database)/documents/karigars/$(tok)).data.active == true; }
    function kRate(tok, k, g) { return get(/databases/$(database)/documents/karigars/$(tok)).data.get('rates', {}).get(k, {}).get(g, 0); }

    match /products/{id} { allow read: if true; allow write: if isAdmin() || dfStaff(); }
    match /config/{id}   { allow read: if true; allow write: if isAdmin() || dfStaff(); }
    match /secret/{doc=**} { allow read, write: if isAdmin(); }

    // Staff apps
    match /reports/{doc}  { allow read, write: if dfStaff(); }
    match /staffcfg/{doc} { allow read, write: if dfStaff(); }
    match /inbox/{doc}    { allow read, create, delete: if dfStaff(); }

    match /users/{uid}/{doc=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /requests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || dfStaff();
    }

    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || dfStaff();
      allow read: if isRider() && (resource.data.status == 'packed' || resource.data.get('rider', '') == myEmail());
      allow update: if isRider()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rider', 'riderName', 'riderAt', 'log', 'deliveredAt', 'cashGot'])
        && (
             (resource.data.status == 'packed' && request.resource.data.status == 'shipped' && request.resource.data.rider == myEmail())
          || (resource.data.status == 'shipped' && resource.data.get('rider', '') == myEmail() && request.resource.data.status == 'delivered' && request.resource.data.rider == myEmail())
          || (resource.data.status == 'shipped' && resource.data.get('rider', '') == myEmail() && request.resource.data.status == 'packed' && request.resource.data.rider == '')
        );
    }

    match /track/{id} {
      allow read: if true;
      allow write: if isAdmin() || dfStaff();
      allow create, update: if isRider()
        && request.resource.data.s in ['shipped', 'delivered', 'packed']
        && request.resource.data.s == getAfter(/databases/$(database)/documents/orders/$(id)).data.status
        && (getAfter(/databases/$(database)/documents/orders/$(id)).data.get('rider', '') == myEmail()
            || get(/databases/$(database)/documents/orders/$(id)).data.get('rider', '') == myEmail());
    }

    // Tailors (कारीगर): each has a secret link /karigar/?k=<id>; blocked = link stops at once
    match /karigars/{tok} {
      allow read, write: if isAdmin() || dfStaff();
      allow get: if resource.data.active == true;
      match /jobs/{jid} {
        allow read, write: if isAdmin() || dfStaff();
        allow read: if get(/databases/$(database)/documents/karigars/$(tok)).data.active == true;
        allow update: if get(/databases/$(database)/documents/karigars/$(tok)).data.active == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kstatus', 'kAt', 'knote']);
      }
      match /deductions/{did} {
        allow read, write: if isAdmin() || dfStaff();
        allow read: if get(/databases/$(database)/documents/karigars/$(tok)).data.active == true;
      }
      // pieces the tailor adds himself (order no. typed or barcode scanned); rate comes from the owner's rate list
      match /work/{wid} {
        allow read, write: if isAdmin() || dfStaff();
        allow read: if kActive(tok);
        allow create: if kActive(tok)
          && request.resource.data.keys().hasOnly(['bid', 'k', 'type', 'grp', 'pcs', 'rate', 'amt', 'ts', 'day', 'idx', 'st'])
          && request.resource.data.st == (get(/databases/$(database)/documents/karigars/$(tok)).data.get('rk', 'tailor') == 'cutting' ? 'cut' : 'sew')
          && request.resource.data.pcs is int && request.resource.data.pcs >= 1 && request.resource.data.pcs <= 500
          && request.resource.data.rate == kRate(tok, request.resource.data.k, request.resource.data.grp)
          && request.resource.data.amt == request.resource.data.pcs * request.resource.data.rate
          && request.resource.data.ts == request.time
          && exists(/databases/$(database)/documents/tjobs/$(request.resource.data.bid));
        allow delete: if kActive(tok) && request.time < resource.data.ts + duration.value(1, 'd');
      }
      // stitching started (finished = moved to work)
      match /wip/{wid} {
        allow read, write: if isAdmin() || dfStaff();
        allow read, delete: if kActive(tok);
        allow create: if kActive(tok)
          && request.resource.data.keys().hasOnly(['bid', 'idx', 'k', 'type', 'grp', 'pcs', 'due', 'at'])
          && request.resource.data.pcs is int && request.resource.data.pcs >= 1 && request.resource.data.pcs <= 500
          && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/tjobs/$(request.resource.data.bid));
      }
    }

    // order number lookup for tailors (no name / phone / address in it)
    match /tjobs/{bid} {
      allow get: if true;
      allow list: if isAdmin() || dfStaff() || resource.data.open == true;
      allow create: if isAdmin() || dfStaff()
        || (request.resource.data.keys().hasOnly(['bid', 'src', 'created', 'items', 'open']) && request.resource.data.items is list && request.resource.data.get('open', false) == false);
      allow update: if isAdmin() || dfStaff() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cut', 'sew', 'wip']);
      allow delete: if isAdmin() || dfStaff();
    }
    match /{path=**}/work/{wid} { allow read: if isAdmin() || dfStaff(); }
    match /{path=**}/wip/{wid} { allow read: if isAdmin() || dfStaff(); }
    match /{path=**}/deductions/{did} { allow read: if isAdmin() || dfStaff(); }
    match /{path=**}/jobs/{jid} { allow read: if isAdmin() || dfStaff(); }

    // Staff added from Admin → स्टाफ
    match /staff/{sid} {
      allow read, write: if isAdmin();
      allow get: if signedIn() && sid == myEmail();
    }

    match /riders/{rid} {
      allow read, write: if isAdmin();
      allow read: if dfStaff();
      allow get: if signedIn() && rid == myEmail();
    }
  }
}
